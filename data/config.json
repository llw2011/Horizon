{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "languages": [
      "zh",
      "en"
    ]
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "langchain-ai",
        "repo": "langchain",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "langchain-ai",
        "repo": "langgraph",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-agents-python",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "crewAIInc",
        "repo": "crewAI",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "pydantic",
        "repo": "pydantic-ai",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "microsoft",
        "repo": "autogen",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "modelcontextprotocol",
        "repo": "python-sdk",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "modelcontextprotocol",
        "repo": "servers",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "google",
        "repo": "A2A",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "astral-sh",
        "repo": "uv",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 50,
      "min_score": 100
    },
    "rss": [
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "Hacker News - AI & Agents",
        "url": "https://hnrss.org/newest?q=AI+agent+OR+LLM+OR+MCP+OR+agentic&count=30",
        "enabled": true,
        "category": "ai-agents"
      },
      {
        "name": "The Batch - Andrew Ng",
        "url": "https://www.deeplearning.ai/the-batch/feed/",
        "enabled": true,
        "category": "ai-industry"
      },
      {
        "name": "TechCrunch AI",
        "url": "https://techcrunch.com/category/artificial-intelligence/feed/",
        "enabled": true,
        "category": "ai-industry"
      },
      {
        "name": "r/artificial RSS",
        "url": "https://www.reddit.com/r/artificial/.rss",
        "enabled": true,
        "category": "ai-reddit"
      },
      {
        "name": "r/LocalLLaMA RSS",
        "url": "https://www.reddit.com/r/LocalLLaMA/.rss",
        "enabled": true,
        "category": "ai-reddit"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": true,
      "ct0_env": "X_CT0",
      "auth_token_env": "X_AUTH_TOKEN",
      "bearer_env": "X_BEARER_TOKEN",
      "users": [
        "AndrewYNg",
        "kaboroevich",
        "swyx",
        "Laboradoodle",
        "alexalbert__",
        "sama",
        "ylecun",
        "goodabith",
        "araborchardt",
        "emaborevkov"
      ],
      "fetch_limit": 20,
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 10,
      "reply_min_likes": 5
    }
  },
  "filtering": {
    "ai_score_threshold": 6.5,
    "time_window_hours": 24
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "chat_id": "1090154635",
      "text": "#{summary}",
      "parse_mode": "Markdown"
    },
    "headers": ""
  }
}
